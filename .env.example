# Copy to .env (never commit .env). Only used by developer scripts, never bundled into the app.

# Solo-mode dev convenience: lets `pnpm scan` call Claude. The desktop app stores keys in the OS keychain instead.
ANTHROPIC_API_KEY=

# Optional: point the engine at an existing Chromium instead of the downloaded Chromium for Testing.
H88CRO_CHROMIUM_PATH=

# Optional: LanguageTool HTTP endpoint (public API or a local server, e.g. http://localhost:8081/v2)
H88CRO_LANGUAGETOOL_URL=

# Phase 2 (Team mode). Used only by `pnpm seed:admin` on the admin's machine.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SEED_ADMIN_EMAIL=admin@h88cro.local
SEED_ADMIN_PASSWORD=
